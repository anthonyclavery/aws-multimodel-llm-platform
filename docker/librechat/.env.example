# Public HTTPS endpoint. DNS must resolve to the Elastic IP before startup.
CADDY_DOMAIN=chat.example.com
CADDY_ACME_EMAIL=ops@example.com

# Persisted on the EC2 EBS volume, outside Docker-managed volumes.
RUNTIME_DATA_ROOT=/opt/aws-multimodel-llm-platform/data

# Pin this to the tested image digest before a production deployment.
LIBRECHAT_IMAGE=ghcr.io/librechat-ai/librechat@sha256:5b706bcee1ca154a1e2987303aaeca0eb27f97919cccee4bb604226c2f8abf61

# LibreChat public URLs.
DOMAIN_CLIENT=https://chat.example.com
DOMAIN_SERVER=https://chat.example.com
TRUST_PROXY=1
SESSION_COOKIE_SECURE=true
SECURITY_HEADERS=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
REFERRER_POLICY=no-referrer
CONSOLE_JSON=true
LOG_TO_FILE=false
ENDPOINTS=bedrock,google

# Local accounts are deliberately closed to public self-registration.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
MIN_PASSWORD_LENGTH=14
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

# Generated at deployment time. Do not commit the resulting .env file.
JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
CREDS_KEY=replace-with-a-random-32-byte-key
CREDS_IV=replace-with-a-random-16-byte-iv

# MongoDB root credentials are bootstrap-only. LibreChat uses the scoped app user.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-random-url-safe-password
MONGO_APP_USERNAME=librechat
MONGO_APP_PASSWORD=replace-with-a-random-url-safe-password
MONGO_URI=mongodb://librechat:replace-with-a-url-encoded-password@mongodb:27017/LibreChat?authSource=LibreChat

# Cost dashboard credentials are generated from a dedicated Secrets Manager secret.
# The MongoDB account has the read role only on the LibreChat database.
COST_DASHBOARD_USERNAME=cost-admin
COST_DASHBOARD_PASSWORD_HASH=replace-with-a-caddy-base64-password-hash
COST_DASHBOARD_MONGO_URI=mongodb://cost_dashboard:replace-with-a-url-encoded-password@mongodb:27017/LibreChat?authSource=LibreChat

# Amazon Bedrock uses the EC2 IAM role. Do not set static AWS credentials.
BEDROCK_AWS_DEFAULT_REGION=eu-central-1
BEDROCK_AWS_MODELS=eu.anthropic.claude-haiku-4-5-20251001-v1:0,eu.anthropic.claude-sonnet-5,eu.anthropic.claude-opus-5,eu.amazon.nova-micro-v1:0,eu.amazon.nova-lite-v1:0,eu.amazon.nova-pro-v1:0

# Google Gemini key retrieved from AWS Secrets Manager at deployment time.
GOOGLE_KEY=replace-with-the-gemini-api-key
